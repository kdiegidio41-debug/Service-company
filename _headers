# Cache rules for Netlify and Cloudflare Pages (both read this file automatically).
# Fonts never change name, so they can be cached for a year. Images, CSS and JS keep
# the same file names when edited, so they're cached for shorter periods.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=604800
/assets/css/*
  Cache-Control: public, max-age=3600
/assets/js/*
  Cache-Control: public, max-age=3600
